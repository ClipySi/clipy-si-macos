    "Copies made while one of these applications is frontmost are never saved to history." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تُحفظ النُسخ التي تتم بينما يكون أحد هذه التطبيقات في المقدمة في السجل أبدًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই অ্যাপ্লিকেশনগুলোর একটি সামনে থাকা অবস্থায় করা কপি কখনোই ইতিহাসে সংরক্ষিত হয় না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopien, die erstellt werden, während eine dieser Apps im Vordergrund ist, werden nie im Verlauf gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las copias hechas mientras una de estas aplicaciones está en primer plano nunca se guardan en el historial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les copies effectuées lorsque l'une de ces applications est au premier plan ne sont jamais enregistrées dans l'historique."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इन ऐप्लिकेशनों में से कोई सबसे आगे होने पर की गई कॉपी कभी इतिहास में सहेजी नहीं जाती।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salinan yang dibuat saat salah satu aplikasi ini berada di depan tidak pernah disimpan ke riwayat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le copie effettuate mentre una di queste applicazioni è in primo piano non vengono mai salvate nella cronologia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのいずれかのアプリケーションが最前面のときにコピーした内容は、履歴に保存されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 응용 프로그램 중 하나가 가장 앞에 있을 때 복사한 내용은 기록에 저장되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cópias feitas enquanto um destes apps está em primeiro plano nunca são salvas no histórico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Копии, сделанные пока одно из этих приложений активно, никогда не сохраняются в историю."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当这些应用程序之一处于最前时进行的复制将不会保存到历史。"
          }
        }
      }
    },
