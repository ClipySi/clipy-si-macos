    "This folder is synced by a cloud service. Its provider can see the encrypted vault files and device metadata — use a strong passphrase." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتم مزامنة هذا المجلد بواسطة خدمة سحابية. يمكن لمزوّدها رؤية ملفات الخزنة المشفّرة وبيانات الأجهزة الوصفية — استخدم عبارة مرور قوية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই ফোল্ডারটি একটি ক্লাউড পরিষেবা দ্বারা সিঙ্ক হয়। এর প্রদানকারী এনক্রিপ্ট করা ভল্ট ফাইল ও ডিভাইস মেটাডেটা দেখতে পারে — একটি শক্তিশালী পাসফ্রেজ ব্যবহার করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Ordner wird von einem Cloud-Dienst synchronisiert. Der Anbieter kann die verschlüsselten Tresordateien und Geräte-Metadaten sehen – verwenden Sie eine starke Passphrase."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta carpeta se sincroniza mediante un servicio en la nube. Su proveedor puede ver los archivos cifrados de la bóveda y los metadatos del dispositivo; usa una frase de contraseña fuerte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce dossier est synchronisé par un service cloud. Son fournisseur peut voir les fichiers chiffrés du coffre et les métadonnées des appareils — utilisez une phrase secrète robuste."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह फ़ोल्डर क्लाउड सेवा द्वारा सिंक किया जाता है। उसका प्रदाता एन्क्रिप्टेड वॉल्ट फ़ाइलें और डिवाइस मेटाडेटा देख सकता है — एक मज़बूत पासफ़्रेज़ का उपयोग करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folder ini disinkronkan oleh layanan cloud. Penyedianya dapat melihat berkas vault terenkripsi dan metadata perangkat — gunakan frasa sandi yang kuat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa cartella è sincronizzata da un servizio cloud. Il provider può vedere i file cifrati del vault e i metadati dei dispositivi: usa una passphrase robusta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このフォルダはクラウドサービスによって同期されています。プロバイダは暗号化された vault ファイルとデバイスのメタデータを見ることができます。強力なパスフレーズを使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 폴더는 클라우드 서비스로 동기화됩니다. 제공업체가 암호화된 볼트 파일과 기기 메타데이터를 볼 수 있습니다. 강력한 암호 문구를 사용하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta pasta é sincronizada por um serviço de nuvem. O provedor pode ver os arquivos criptografados do cofre e os metadados do dispositivo — use uma frase-senha forte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта папка синхронизируется облачным сервисом. Его провайдер может видеть зашифрованные файлы хранилища и метаданные устройств — используйте надёжную парольную фразу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件夹由云服务同步。其提供商可以看到加密的保管库文件和设备元数据——请使用强口令。"
          }
        }
      }
    },
    "Title" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
