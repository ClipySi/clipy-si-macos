    "Your clipboard history is encrypted and stored only on your Mac." : {
      "comment" : "Onboarding bullet: encryption",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم تشفير سجل الحافظة وتخزينه على جهاز Mac الخاص بك فقط."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার ক্লিপবোর্ড ইতিহাস এনক্রিপ্ট করা হয় এবং শুধু আপনার Mac-এ সংরক্ষিত থাকে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Zwischenablage-Verlauf wird verschlüsselt und nur auf deinem Mac gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu historial del portapapeles se cifra y se guarda solo en tu Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre historique du presse-papiers est chiffré et stocké uniquement sur votre Mac."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका क्लिपबोर्ड इतिहास एन्क्रिप्टेड है और केवल आपके Mac पर संग्रहीत होता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riwayat papan klip Anda dienkripsi dan hanya disimpan di Mac Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cronologia degli appunti è crittografata e salvata solo sul tuo Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリップボード履歴は暗号化され、お使いの Mac 内だけに保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클립보드 기록은 암호화되어 사용자의 Mac에만 저장됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu histórico da área de transferência é criptografado e armazenado apenas no seu Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "История буфера обмена шифруется и хранится только на вашем Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的剪贴板历史经过加密，且仅存储在你的 Mac 上。"
          }
        }
      }
    },
    "Your history now has %lld items, above the limit of %lld. Increase the limit to keep them all, or remove the oldest items beyond the limit?" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتوي سجلّك الآن على %lld عنصر، أي أكثر من الحد البالغ %lld. هل تريد زيادة الحد للاحتفاظ بها جميعًا، أم إزالة أقدم العناصر التي تتجاوز الحد؟"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার ইতিহাসে এখন %lld টি আইটেম রয়েছে, যা %lld সীমার বেশি। সব রাখতে সীমা বাড়ান, নাকি সীমার বাইরের পুরোনো আইটেমগুলো মুছবেন?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Verlauf umfasst jetzt %lld Objekte und liegt damit über dem Limit von %lld. Das Limit erhöhen, um alle zu behalten, oder die ältesten Objekte über dem Limit entfernen?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu historial tiene ahora %lld elementos, por encima del límite de %lld. ¿Aumentar el límite para conservarlos todos o eliminar los elementos más antiguos que superan el límite?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre historique compte désormais %lld éléments, au-delà de la limite de %lld. Augmenter la limite pour tout conserver, ou supprimer les éléments les plus anciens au-delà de la limite ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके इतिहास में अब %lld आइटम हैं, जो %lld की सीमा से अधिक हैं। सभी रखने के लिए सीमा बढ़ाएँ, या सीमा से अधिक पुराने आइटम हटाएँ?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riwayat Anda kini berisi %lld item, melebihi batas %lld. Tingkatkan batas untuk menyimpan semuanya, atau hapus item terlama yang melebihi batas?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cronologia contiene ora %lld elementi, oltre il limite di %lld. Aumentare il limite per conservarli tutti o rimuovere gli elementi più vecchi oltre il limite?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "履歴が %lld 件になり、上限の %lld 件を超えています。すべて保持するには上限を増やすか、上限を超える古い項目を削除しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록이 이제 %lld개로 한도 %lld개를 초과합니다. 모두 유지하려면 한도를 늘리거나, 한도를 초과한 가장 오래된 항목을 삭제할까요?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu histórico agora tem %lld itens, acima do limite de %lld. Aumentar o limite para manter todos ou remover os itens mais antigos que excedem o limite?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В истории теперь %lld объектов, что превышает лимит %lld. Увеличить лимит, чтобы сохранить все, или удалить старые объекты сверх лимита?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的历史记录现在有 %lld 个项目，超过了 %lld 的上限。增加上限以全部保留，或删除超出上限的最旧项目？"
          }
        }
      }
    },
