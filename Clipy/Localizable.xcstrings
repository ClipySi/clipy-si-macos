    "Approve ClipySi under Login Items in System Settings to finish enabling launch at login." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وافق على ClipySi ضمن عناصر تسجيل الدخول في إعدادات النظام لإكمال تفعيل التشغيل عند تسجيل الدخول."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "লগইনে চালু করা সম্পূর্ণ করতে সিস্টেম সেটিংস-এ লগইন আইটেম-এর অধীনে ClipySi অনুমোদন করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestätige ClipySi in den Anmeldeobjekten der Systemeinstellungen, um den Start bei der Anmeldung zu aktivieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprueba ClipySi en Ítems de inicio de sesión en Ajustes del Sistema para terminar de activar la apertura al iniciar sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Approuvez ClipySi dans les éléments d'ouverture des Réglages Système pour terminer l'activation du lancement à l'ouverture de session."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लॉगिन पर लॉन्च सक्षम करने के लिए सिस्टम सेटिंग्स में लॉगिन आइटम के अंतर्गत ClipySi को स्वीकृत करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setujui ClipySi di bawah Item Masuk di Pengaturan Sistem untuk menyelesaikan pengaktifan peluncuran saat masuk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Approva ClipySi in Elementi login nelle Impostazioni di Sistema per completare l'attivazione dell'avvio al login."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログイン時の起動を有効にするには、システム設定の「ログイン項目」で ClipySi を承認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인 시 실행을 완료하려면 시스템 설정의 로그인 항목에서 ClipySi를 승인하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprove o ClipySi em Itens de Início nos Ajustes do Sistema para concluir a ativação da abertura no login."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подтвердите ClipySi в разделе «Объекты входа» в Системных настройках, чтобы завершить включение запуска при входе."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“系统设置”的“登录项”中批准 ClipySi，以完成启用登录时启动。"
          }
        }
      }
    },
    "Ask for Touch ID or your login password before a masked value is shown or pasted." : {
      "comment" : "Privacy pane: reveal-auth footer",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المطالبة بـ Touch ID أو كلمة مرور تسجيل الدخول قبل إظهار قيمة مُخفاة أو لصقها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কোনো মাস্ক করা মান দেখানো বা পেস্ট করার আগে Touch ID বা আপনার লগইন পাসওয়ার্ড চান।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vor dem Anzeigen oder Einfügen eines maskierten Werts nach Touch ID oder Ihrem Anmeldekennwort fragen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pedir Touch ID o tu contraseña de inicio de sesión antes de mostrar o pegar un valor enmascarado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demander Touch ID ou votre mot de passe de session avant d’afficher ou de coller une valeur masquée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी मास्क किए गए मान को दिखाने या पेस्ट करने से पहले Touch ID या अपना लॉगिन पासवर्ड माँगें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minta Touch ID atau kata sandi login Anda sebelum nilai yang disamarkan ditampilkan atau ditempel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richiedi il Touch ID o la password di accesso prima di mostrare o incollare un valore mascherato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マスクされた値を表示または貼り付ける前に、Touch ID またはログインパスワードを要求します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마스킹된 값을 표시하거나 붙여넣기 전에 Touch ID 또는 로그인 암호를 요청합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicitar o Touch ID ou sua senha de login antes de mostrar ou colar um valor mascarado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запрашивать Touch ID или пароль для входа перед показом или вставкой замаскированного значения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在显示或粘贴被遮蔽的值之前，要求 Touch ID 或登录密码。"
          }
        }
      }
    },
    "Authenticate to paste a hidden secret." : {
      "comment" : "LocalAuthentication reason when pasting a masked clip",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
