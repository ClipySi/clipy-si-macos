    "Never collected: clipboard contents, clip titles, snippet bodies, search queries, email addresses, tokens, encryption keys, or source-app details." : {
      "comment" : "Diagnostics pane: never-collected footer",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يتم جمعه أبدًا: محتوى الحافظة، عناوين العناصر، نصوص المقتطفات، عمليات البحث، عناوين البريد الإلكتروني، الرموز المميزة، مفاتيح التشفير، أو تفاصيل التطبيق المصدر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কখনও সংগ্রহ করা হয় না: ক্লিপবোর্ডের বিষয়বস্তু, ক্লিপের শিরোনাম, স্নিপেটের লেখা, সার্চ, ইমেল ঠিকানা, টোকেন, এনক্রিপশন কী, বা উৎস অ্যাপের বিবরণ।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie erfasst: Zwischenablage-Inhalte, Titel von Einträgen, Snippet-Texte, Suchanfragen, E-Mail-Adressen, Tokens, Verschlüsselungsschlüssel oder Details der Quell-App."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca se recopila: contenido del portapapeles, títulos de elementos, cuerpos de fragmentos, búsquedas, direcciones de correo, tokens, claves de cifrado ni detalles de la app de origen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jamais collecté : contenu du presse-papiers, titres des éléments, corps des extraits, recherches, adresses e-mail, jetons, clés de chiffrement ou détails de l’app source."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कभी एकत्र नहीं किया जाता: क्लिपबोर्ड सामग्री, क्लिप शीर्षक, स्निपेट सामग्री, खोज क्वेरी, ईमेल पते, टोकन, एन्क्रिप्शन कुंजियाँ, या स्रोत-ऐप विवरण।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak pernah dikumpulkan: konten papan klip, judul klip, isi cuplikan, kueri pencarian, alamat email, token, kunci enkripsi, atau detail aplikasi sumber."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mai raccolto: contenuti degli appunti, titoli degli elementi, corpo degli snippet, ricerche, indirizzi e-mail, token, chiavi di crittografia o dettagli dell’app di origine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "収集しないもの：クリップボードの内容、クリップのタイトル、スニペット本文、検索語、メールアドレス、トークン、暗号化鍵、コピー元アプリの詳細。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "절대 수집하지 않음: 클립보드 내용, 클립 제목, 스니펫 본문, 검색어, 이메일 주소, 토큰, 암호화 키, 출처 앱 세부정보."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca coletado: conteúdo da área de transferência, títulos de itens, corpos de trechos, buscas, endereços de e-mail, tokens, chaves de criptografia ou detalhes do app de origem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Никогда не собирается: содержимое буфера обмена, заголовки записей, тексты сниппетов, поисковые запросы, адреса эл. почты, токены, ключи шифрования и сведения о приложении-источнике."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "绝不收集：剪贴板内容、剪贴标题、片段正文、搜索词、电子邮件地址、令牌、加密密钥或来源应用详情。"
          }
        }
      }
